/* ===================================================
   СТИЛІ ДЛЯ ФОРМИ (ВАРІАНТ 1)
   =================================================== */

/* Біла рамка форми, щоб виділити її на чорному фоні сторінки */
.variant1-form {
    background-color: #ffffff;
    color: #000000;
    padding: 15px 20px;
    width: fit-content;
    font-family: "Times New Roman", Times, serif;
    font-size: 16px;
    margin-top: 15px;
}

/* Червоний заголовок форми */
.variant1-form .red-title {
    color: red;
    text-align: center;
    font-weight: normal;
    margin: 0 0 12px 0;
    font-size: 18px;
}

.variant1-form .form-row {
    margin-bottom: 5px;
}

.variant1-form label, 
.variant1-form span {
    color: #000000;
}

/* Інпути та текстове поле */
.variant1-form input[type="text"],
.variant1-form input[type="password"] {
    font-family: "Times New Roman", Times, serif;
    font-size: 15px;
    border: 1px solid #7f9db9;
    padding: 1px 3px;
}

.variant1-form textarea {
    font-family: "Courier New", Courier, monospace;
    font-size: 14px;
    border: 1px solid #7f9db9;
    margin-top: 5px;
}

.variant1-form .checkbox-group p {
    margin: 6px 0 2px 0;
}

/* Ретро-кнопки Windows */
.variant1-form .form-buttons {
    margin-top: 8px;
}

.variant1-form input[type="reset"] {
    background-color: #d4d0c8;
    color: #000000;
    border: 1px solid #808080;
    padding: 2px 10px;
    cursor: pointer;
    font-family: "Times New Roman", Times, serif;
    margin-bottom: 4px;
}

.variant1-form input[type="submit"] {
    background-color: #d4d0c8;
    color: #000000;
    border: 1px solid #808080;
    padding: 1px 12px;
    cursor: pointer;
    font-family: "Times New Roman", Times, serif;
}
